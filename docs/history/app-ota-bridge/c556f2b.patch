+    use sha2::Digest;
+    fn manifest_bytes()->Vec<u8> {
+        let mut b=vec![0u8;64];b[..4].copy_from_slice(b"AMF3");b[4]=1;b[6]=64;b[8]=64;b[14]=160;b[16]=1;
+        let hash=sha2::Sha256::digest(&b);b[32..64].copy_from_slice(&hash);b
