# 大文件与生成物默认不入库：保留在本地归档，按 checksums/SHA256SUMS.txt 对账
# ROM 镜像（下方明确放行的原厂 0031 / 0041 除外）
roms/**/*.bin
roms/**/*.json
# 逆向运行证据（REA Evidence、QEMU 运行、Ghidra 安装、私有 profile）
evidence/
# 可再生成的构建产物与第三方依赖
reverse/rehost/
reverse/app-0031/deps/
# 二进制与打包物
*.bin
!/roms/0031/ap01-1.0.2_0031.bin
!/roms/0041/ap01-1.0.2_0041.bin
*.elf
*.tgz
*.tar
*.gz
*.zip
*.7z
*.png
*.jpg
*.ppm
*.gif
*.lib
*.o
*.obj
*.jar
*.whl
*.py[cod]
*.class
*.db
*.gbf
*.fidbf
*.sla
*.pypredef
*.gpr
*.rep
# Ghidra 13 位十六进制资源头（每份 15–17 MB，由 rehost-assets.py 生成）
reverse/**/ap01-assets.h
reverse/**/round*-ap01-assets.h
# 本地缓存
__pycache__/
# 分析生成物仅存本地归档；源码、语义合同和必要清单显式保留。
/reverse/analysis/**/*
!/reverse/analysis/**/
!/reverse/analysis/**/*.py
!/reverse/analysis/**/*.mjs
!/reverse/analysis/**/*.pem
!/reverse/analysis/**/.gitignore
!/reverse/analysis/**/README.md
!/reverse/analysis/**/contracts.json
!/reverse/analysis/**/contract.json
!/reverse/analysis/opensource-audit-20261024.json
!/reverse/analysis/factory-code-resources-0041-inventory.json
!/reverse/analysis/usb-ota-payloads-0041-20261023.json
!/reverse/analysis/buzzer-backlight-round2-20261023/mapping-and-boundaries.json
!/reverse/analysis/whole-rom-summary-0041.json
# 即使目录内存在源码/合同同名文件，也不收录本地工具缓存和虚拟环境。
/reverse/analysis/**/__pycache__/
/reverse/analysis/**/.pytest_cache/
/reverse/analysis/**/.mypy_cache/
/reverse/analysis/**/.venv/
/reverse/raw/**/*
!/reverse/raw/**/
!/reverse/raw/**/*.c
!/reverse/raw/**/*.h
!/reverse/raw/**/*.py
!/reverse/raw/**/*.md
/reverse/app-0031/
/checksums/SHA256SUMS.txt
